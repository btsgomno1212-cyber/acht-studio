# ---------------------------------------------------------------------------
# Umgebungsvariablen
#
# Lokal:   Diese Datei nach ".env.local" kopieren und ausfüllen.
# Vercel:  Dieselben Namen unter Project → Settings → Environment Variables
#          eintragen und danach neu deployen.
# ---------------------------------------------------------------------------

# Öffentliche Adresse der Website, ohne Slash am Ende.
# Wird für Canonical-Links, Sitemap und Vorschaubilder gebraucht.
NEXT_PUBLIC_SITE_URL=https://www.ihre-domain.de

# --- Anfrageformular -------------------------------------------------------

# An diese Adresse gehen die Anfragen aus dem Formular.
MAIL_TO=hallo@ihre-domain.de

# Absender der Benachrichtigung. Muss eine Adresse sein, die Ihr Postfach
# (SMTP) bzw. Ihre bei Resend bestätigte Domain versenden darf.
MAIL_FROM="Website <website@ihre-domain.de>"

# Weg 1: SMTP – funktioniert mit jedem Postfach.
# Die Werte stehen in den Einstellungen Ihres E-Mail-Anbieters.
SMTP_HOST=smtp.ihr-anbieter.de
SMTP_PORT=587
SMTP_USER=website@ihre-domain.de
SMTP_PASS=
# Nur setzen, wenn der Anbieter es verlangt: "true" für Port 465, sonst leer.
# SMTP_SECURE=true

# Weg 2: Resend (https://resend.com) – statt SMTP.
# Ist dieser Schlüssel gesetzt, wird Resend verwendet und SMTP ignoriert.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
